[Unit]
Description=Seven OpenJarvis API
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=sevenjarvis
Group=sevenjarvis
WorkingDirectory=/opt/seven-openjarvis/app
Environment=HOME=/var/lib/seven-openjarvis
Environment=PATH=/opt/seven-openjarvis/app/.venv/bin:/var/lib/seven-openjarvis/.openclaw/bin:/usr/local/bin:/usr/bin:/bin
Environment="SEVEN_BRAIN_VAULT=/var/lib/seven-openjarvis/Documents/Seven Brain"
Environment=OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
Environment=OPENCLAW_BIN=/var/lib/seven-openjarvis/.openclaw/bin/openclaw
Environment=OPENCLAW_GATEWAY_TOKEN_FILE=/var/lib/seven-openjarvis/.openclaw/gateway.token
Environment=SEVEN_ADMIN_USER=matheus
Environment=SEVEN_ADMIN_ORIGIN=https://voice.seven.7build.com.br
ExecStart=/opt/seven-openjarvis/app/.venv/bin/python -m openjarvis.cli serve --host 127.0.0.1 --port 8737 --engine ollama --model qwen3.5:2b --agent none
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/seven-openjarvis

[Install]
WantedBy=multi-user.target

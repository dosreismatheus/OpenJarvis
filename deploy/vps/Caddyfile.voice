voice.seven.7build.com.br {
  encode zstd gzip

  # O Segundo Cérebro e a API ficam protegidos pelo mesmo acesso.
  basicauth {
    matheus __BCRYPT_HASH__
  }

  handle /v1/* {
    reverse_proxy 127.0.0.1:8737 {
      header_up -Authorization
      header_up X-Seven-Auth-User {http.auth.user.id}
    }
  }
  handle /api/* {
    reverse_proxy 127.0.0.1:8737 {
      header_up -Authorization
    }
  }
  handle /health {
    reverse_proxy 127.0.0.1:8737 {
      header_up -Authorization
    }
  }
  handle /dashboard {
    reverse_proxy 127.0.0.1:8737 {
      header_up -Authorization
    }
  }
  handle /ws* {
    reverse_proxy 127.0.0.1:8737 {
      header_up -Authorization
    }
  }

  handle /assets/* {
    root * /srv/seven-voice-next
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv/seven-voice-next
    header Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
